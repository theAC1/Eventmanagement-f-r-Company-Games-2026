{
  // Wartungs-Scripts (scripts/*.ts, prisma/seed.ts) laufen unter ts-node in
  // CommonJS. Die Einstellung stand vorher als --compiler-options-Argument im
  // npm-Script; dessen Anführungszeichen überlebten die Shell im Container
  // nicht ("SyntaxError: Expected property name"). Als Projektdatei gibt es
  // nichts mehr zu quoten — plattformunabhängig.
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["scripts/**/*.ts", "prisma/**/*.ts", "src/lib/**/*.ts"],
  "exclude": ["node_modules"]
}
